  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "List the forward pick faces of a site ordered by forward bin, a page at a time (default 100, max 500), each with its SKU, on_hand, reserved and available quantity, the policy min_qty and max_qty (omitted without a policy), the open_request_id (omitted without an open request) and a status: BELOW_MIN (the projected level is at or below the minimum), OK, NO_SOURCE (below minimum but no reserve bin can supply it) or NO_POLICY. Optionally only one status. Levels are the event-fed local copy. Read-only; fails with invalid-site-id for a blank site, invalid-status for an unknown status, invalid-limit and invalid-cursor.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "description": "the opaque next_cursor returned by the previous page; omitted means the first page",
          "type": "string"
        },
        "limit": {
          "description": "page size, 1..500; omitted or 0 means 100",
          "type": "integer"
        },
        "site_id": {
          "description": "the site whose forward pick faces to list (required), e.g. SITE-1",
          "type": "string"
        },
        "status": {
          "description": "keep only pick faces in this status: BELOW_MIN, OK, NO_SOURCE or NO_POLICY; omitted means every status",
          "type": "string"
        }
      },
      "required": [
        "site_id"
      ],
      "type": "object"
    },
    "name": "list_pick_faces",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "available": {
                "type": "integer"
              },
              "forward_bin": {
                "type": "string"
              },
              "max_qty": {
                "type": [
                  "null",
                  "integer"
                ]
              },
              "min_qty": {
                "type": [
                  "null",
                  "integer"
                ]
              },
              "on_hand": {
                "type": "integer"
              },
              "open_request_id": {
                "type": "string"
              },
              "reserved": {
                "type": "integer"
              },
              "site_id": {
                "type": "string"
              },
              "sku": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "site_id",
              "forward_bin",
              "sku",
              "on_hand",
              "reserved",
              "available",
              "status"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    }
